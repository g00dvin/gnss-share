<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Warning banner (gone unless there is something to warn about) -->
    <LinearLayout
        android:id="@+id/connectBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_banner"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="11dp"
        android:paddingVertical="10dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_warning_fill"
            android:tint="@color/ls_error" />

        <TextView
            android:id="@+id/bannerText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/ls_text"
            android:textSize="11.5sp" />

        <ImageView
            android:id="@+id/bannerDismiss"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/cd_dismiss"
            android:src="@drawable/ic_x"
            android:tint="@color/ls_text_dim" />
    </LinearLayout>

    <!-- Circle fills the remaining vertical space -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="264dp">

        <goodvin.locsync.shared.PowerOrbView
            android:id="@+id/powerOrb"
            android:layout_width="264dp"
            android:layout_height="264dp"
            android:layout_gravity="center"
            android:clickable="true"
            android:focusable="true" />
    </FrameLayout>

    <!-- Status block -->
    <TextView
        android:id="@+id/statusLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:textColor="@color/ls_text_muted"
        android:textSize="19sp" />

    <TextView
        android:id="@+id/statusSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:textColor="@color/ls_text_muted"
        android:textSize="12sp" />

    <!-- Stat row: 3 equal cards -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="14dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <include layout="@layout/ls_stat_card" android:id="@+id/statCard1"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />

        <Space android:layout_width="8dp" android:layout_height="1dp" />

        <include layout="@layout/ls_stat_card" android:id="@+id/statCard2"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />

        <Space android:layout_width="8dp" android:layout_height="1dp" />

        <include layout="@layout/ls_stat_card" android:id="@+id/statCard3"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
    </LinearLayout>

    <!-- Signal card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="14dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.10"
                android:text="@string/signal_title"
                android:textAllCaps="true"
                android:textColor="@color/ls_text_dim"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/signalDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/ls_text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <goodvin.locsync.shared.SatelliteBarsView
            android:id="@+id/satBars"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="14dp" />
</LinearLayout>
